<!-- Mobile bottom nav — Restrained Floating Pill (VS removed: header Compare is single source) -->
<nav class="sm:hidden fixed bottom-3 left-1/2 -translate-x-1/2 z-40 w-[calc(100%-1.5rem)] max-w-sm" aria-label="Mobile Navigation">
  <div class="glass rounded-full p-1 flex items-center justify-between shadow-xl mb-[env(safe-area-inset-bottom)]">
    <button
      @click="modelsViewMode = 'table'"
      :aria-pressed="modelsViewMode === 'table'"
      aria-label="Table View"
      class="flex-1 px-3 py-2.5 min-h-[38px] rounded-full text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
      :class="modelsViewMode === 'table' ? 'bg-[var(--strong)] text-[var(--bg)] dark:text-[#090d10] shadow-xs' : 'text-[var(--muted)] hover:text-[var(--strong)]'"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#icon-list" /></svg>
      <span>Table</span>
    </button>

    <button
      @click="modelsViewMode = 'plot'"
      :aria-pressed="modelsViewMode === 'plot'"
      aria-label="Scatter Plots View"
      class="flex-1 px-3 py-2.5 min-h-[38px] rounded-full text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
      :class="modelsViewMode === 'plot' ? 'bg-[var(--strong)] text-[var(--bg)] dark:text-[#090d10] shadow-xs' : 'text-[var(--muted)] hover:text-[var(--strong)]'"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#icon-plot" /></svg>
      <span>Plot</span>
    </button>

    <button
      @click="modelsViewMode = 'timeline'"
      :aria-pressed="modelsViewMode === 'timeline'"
      aria-label="SOTA Timeline View"
      class="flex-1 px-3 py-2.5 min-h-[38px] rounded-full text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
      :class="modelsViewMode === 'timeline' ? 'bg-[var(--strong)] text-[var(--bg)] dark:text-[#090d10] shadow-xs' : 'text-[var(--muted)] hover:text-[var(--strong)]'"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#icon-calendar" /></svg>
      <span>Timeline</span>
    </button>
  </div>
</nav>
