<!-- PRO TOP NAVIGATION BAR (OPENROUTER CRAFT & PRECISION) -->
<header class="sticky top-0 z-40 w-full border-b border-[var(--glass-brd)] bg-[var(--glass-bg)] backdrop-blur-md transition-colors">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 gap-3">
    
    <!-- Left: Brand Logo & Title -->
    <div class="flex items-center gap-3 shrink-0">
      <a href="#models" @click="modelsViewMode = 'table'" class="flex items-center gap-2.5 group cursor-pointer text-decoration-none">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-lime-400 to-[#c6ff00] text-black flex items-center justify-center font-black text-sm shadow-[0_1px_12px_rgba(198,255,0,0.45)] group-hover:scale-105 transition-transform">
          <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-extrabold text-sm sm:text-base tracking-tight text-[var(--strong)]">OBench</span>
          <div class="hidden sm:flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[var(--chip-bg)] border border-[var(--glass-brd)] text-[10px] font-mono font-bold text-[var(--soft)]">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span x-text="`${data.models.length} Models`"></span>
          </div>
        </div>
      </a>
    </div>

    <!-- Center: Search Bar with ⌘K -->
    <div class="flex-1 max-w-md mx-2 hidden sm:block">
      <div class="relative flex items-center w-full group">
        <svg class="w-4 h-4 text-[var(--muted)] absolute left-3 pointer-events-none group-focus-within:text-emerald-700 dark:group-focus-within:text-[#c6ff00] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          id="search-input"
          type="search"
          x-model="search"
          placeholder="Filter models, providers (e.g. Claude 3.7, DeepSeek R1, GPT-4.5)..."
          class="w-full h-9 pl-9 pr-14 text-xs rounded-lg bg-[var(--field-bg)] border border-[var(--field-border)] text-[var(--strong)] placeholder-[var(--muted)] focus:outline-none focus:border-emerald-600 dark:focus:border-[#c6ff00] transition-all shadow-inner"
        />
        <div class="absolute right-2.5 flex items-center gap-0.5 pointer-events-none">
          <kbd>⌘</kbd>
          <kbd>K</kbd>
        </div>
      </div>
    </div>

    <!-- Right: Quick Actions -->
    <div class="flex items-center gap-2 shrink-0">
      
      <!-- Compare Drawer Trigger Button (if models pinned) -->
      <template x-if="comparedModelIds.length > 0">
        <button
          @click="modelsViewMode = 'compare'"
          class="h-8.5 px-2.5 text-xs font-bold rounded-lg bg-emerald-50 border border-emerald-300 text-emerald-800 dark:bg-lime-500/15 dark:border-lime-500/40 dark:text-[#c6ff00] flex items-center gap-1 cursor-pointer hover:bg-emerald-100 dark:hover:bg-lime-500/25 transition-colors"
          title="View side-by-side comparison"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <use href="#icon-compare" />
          </svg>
          <span class="font-mono text-[11px]" x-text="`VS (${comparedModelIds.length})`"></span>
        </button>
      </template>

      <!-- Sync Button -->
      <button
        @click="syncModels()"
        :disabled="syncing"
        class="h-8.5 px-3 text-xs font-bold rounded-lg btn-secondary flex items-center gap-1.5 cursor-pointer disabled:opacity-50"
        title="Sync models directly from Artificial Analysis"
        aria-label="Sync models"
      >
        <svg class="w-3.5 h-3.5" :class="syncing ? 'animate-spin' : ''" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        <span class="hidden md:inline" x-text="syncing ? 'Syncing...' : 'Sync Data'"></span>
      </button>

      <!-- Theme Switcher -->
      <button
        @click="toggleTheme()"
        class="w-8.5 h-8.5 flex items-center justify-center rounded-lg text-[var(--soft)] hover:text-[var(--strong)] hover:bg-[var(--chip-hover)] transition-colors cursor-pointer"
        title="Toggle dark / light theme"
        aria-label="Toggle theme"
      >
        <svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Search Input Strip -->
  <div class="sm:hidden px-4 pb-2.5 pt-1">
    <div class="relative flex items-center w-full">
      <svg class="w-3.5 h-3.5 text-[var(--muted)] absolute left-3 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input
        type="search"
        x-model="search"
        placeholder="Filter models..."
        class="w-full h-8.5 pl-8 pr-3 text-xs rounded-lg bg-[var(--field-bg)] border border-[var(--field-border)] text-[var(--strong)] placeholder-[var(--muted)] focus:outline-none focus:border-[#84cc16] dark:focus:border-[#c6ff00]"
      />
    </div>
  </div>
</header>
