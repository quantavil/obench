<!-- Header — OpenRouter Minimal Precision & Ergonomics -->
<header class="sticky top-0 z-40 w-full border-b border-[var(--glass-brd)] bg-[var(--glass-bg)] backdrop-blur-xl">
  <div class="mx-auto flex h-[56px] max-w-[1380px] items-center justify-between px-4 sm:px-8 gap-3">

    <!-- Left: Brand Logo & Title -->
    <div class="flex items-center gap-3 shrink-0">
      <a href="#models" @click="modelsViewMode = 'table'" class="flex items-center gap-2.5 group cursor-pointer" aria-label="OBench Home">
        <div class="w-8 h-8 rounded-[9px] bg-[var(--accent)] text-[#090d10] flex items-center justify-center group-hover:scale-[1.02] transition-transform shadow-xs">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-[15px] tracking-tight text-[var(--strong)]">OBench</span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--chip-bg)] border border-[var(--glass-brd)] px-2 py-0.5 text-[11px] font-mono font-medium text-[var(--soft)]">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
            <span x-text="`${data.models.length}`"></span>
            <span class="text-[var(--muted)] hidden xs:inline">models</span>
          </span>
        </div>
      </a>
      <span class="hidden lg:inline text-xs text-[var(--muted)] ml-1 pl-3 border-l border-[var(--glass-brd)] font-medium">Intelligence & Cost Explorer</span>
    </div>

    <!-- Center: Search with ⌘K & Instant Clear Button -->
    <div class="flex-1 max-w-[540px] mx-2 hidden md:block" role="search">
      <div class="relative flex items-center w-full group">
        <svg class="w-4 h-4 text-[var(--muted)] absolute left-3 pointer-events-none group-focus-within:text-[var(--strong)] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          id="search-input"
          type="search"
          x-model="search"
          placeholder="Search models, providers, capabilities…"
          aria-label="Search models"
          class="w-full h-9 pl-9 pr-20 text-[13px] rounded-[10px] bg-[var(--field-bg)] border border-[var(--field-border)] text-[var(--strong)] placeholder:text-[var(--muted)] focus:outline-none focus:border-[var(--strong)] dark:focus:border-[var(--accent)] transition-all"
        />
        <div class="absolute right-2 flex items-center gap-1.5">
          <template x-if="search">
            <button
              @click="search = ''; $el.previousElementSibling?.focus()"
              class="w-4 h-4 rounded-full flex items-center justify-center text-[var(--muted)] hover:text-[var(--strong)] cursor-pointer mr-1"
              title="Clear search"
              aria-label="Clear search"
            >
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><use href="#icon-close" /></svg>
            </button>
          </template>
          <div class="flex items-center gap-0.5 pointer-events-none">
            <kbd class="hidden sm:inline-flex">⌘</kbd>
            <kbd class="hidden sm:inline-flex">K</kbd>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Actions -->
    <div class="flex items-center gap-2 shrink-0">

      <!-- Compare Mode Toggle Button -->
      <button
        @click="showCompareCol && comparedModelIds.length >= 2 && modelsViewMode === 'table' ? applyComparison() : toggleCompareCol()"
        class="h-8 px-3 text-xs font-semibold rounded-full border transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs select-none"
        :class="showCompareCol || modelsViewMode === 'compare' ? 'bg-[var(--accent)] text-[#090d10] border-[var(--accent)] shadow-xs' : 'border-[var(--glass-brd)] bg-[var(--panel)] text-[var(--strong)] hover:bg-[var(--chip-bg)]'"
        :title="showCompareCol ? 'Toggle VS comparison column' : 'Enable VS comparison mode'"
        aria-label="Toggle comparison"
        :aria-pressed="showCompareCol || modelsViewMode === 'compare'"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><use href="#icon-compare" /></svg>
        <span>Compare</span>
        <template x-if="comparedModelIds.length > 0">
          <span
            class="min-w-4 h-4 px-1 rounded-full text-[10px] flex items-center justify-center font-bold font-mono transition-colors"
            :class="showCompareCol || modelsViewMode === 'compare' ? 'bg-[var(--accent)] text-[#090d10]' : 'bg-[var(--strong)] text-[var(--bg)] dark:text-[#090d10]'"
            x-text="comparedModelIds.length"
          ></span>
        </template>
      </button>

      <!-- Live Sync Button -->
      <button
        @click="syncModels()"
        :disabled="syncing"
        :aria-busy="syncing"
        class="h-8 px-3 text-xs font-medium rounded-full border border-[var(--glass-brd)] bg-[var(--panel)] text-[var(--strong)] flex items-center gap-1.5 cursor-pointer hover:bg-[var(--chip-bg)] disabled:opacity-50 transition-colors shadow-2xs"
        title="Sync live telemetry from Artificial Analysis"
        aria-label="Sync live telemetry"
      >
        <svg class="w-3.5 h-3.5" :class="syncing && 'animate-spin'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        <span class="hidden sm:inline font-medium" x-text="syncing ? 'Syncing…' : 'Sync'"></span>
      </button>

      <!-- Dark / Light Theme Toggle -->
      <button
        @click="toggleTheme()"
        class="w-8 h-8 flex items-center justify-center rounded-full border border-transparent text-[var(--muted)] hover:text-[var(--strong)] hover:bg-[var(--chip-bg)] hover:border-[var(--glass-brd)] transition-colors cursor-pointer"
        title="Toggle dark/light theme"
        :aria-label="isDark ? 'Switch to light theme' : 'Switch to dark theme'"
      >
        <svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Search Bar -->
  <div class="md:hidden px-4 pb-3 pt-0" role="search">
    <div class="relative flex items-center w-full">
      <svg class="w-3.5 h-3.5 text-[var(--muted)] absolute left-3 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input
        type="search"
        x-model="search"
        placeholder="Search models, providers…"
        aria-label="Search models"
        class="w-full h-9 pl-8 pr-8 text-[13px] rounded-[10px] bg-[var(--field-bg)] border border-[var(--field-border)] text-[var(--strong)] placeholder:text-[var(--muted)] focus:outline-none focus:border-[var(--strong)] dark:focus:border-[var(--accent)]"
      />
      <template x-if="search">
        <button
          @click="search = ''"
          class="absolute right-2.5 w-4 h-4 rounded-full flex items-center justify-center text-[var(--muted)] hover:text-[var(--strong)] cursor-pointer"
          title="Clear"
          aria-label="Clear search"
        >
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><use href="#icon-close" /></svg>
        </button>
      </template>
    </div>
  </div>
</header>
