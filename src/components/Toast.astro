<!-- Toast — Severity-Aware Notification -->
<div
  x-show="toastMsg"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0 translate-y-2 scale-95"
  x-transition:enter-end="opacity-100 translate-y-0 scale-100"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100 translate-y-0 scale-100"
  x-transition:leave-end="opacity-0 translate-y-2 scale-95"
  class="fixed bottom-20 md:bottom-6 left-1/2 -translate-x-1/2 z-[60] flex items-center gap-2.5 rounded-full px-4 py-2 shadow-xl text-xs font-medium mb-[env(safe-area-inset-bottom)] border"
  :class="toastSeverity === 'error' ? 'bg-rose-950 text-rose-100 border-rose-800 dark:bg-rose-950 dark:text-rose-200 dark:border-rose-700' : toastSeverity === 'warning' ? 'bg-amber-950 text-amber-100 border-amber-800 dark:bg-amber-950 dark:text-amber-200 dark:border-amber-700' : 'bg-[var(--panel)] text-[var(--strong)] border-[var(--glass-brd)] shadow-2xl'"
  :role="toastSeverity === 'error' ? 'alert' : 'status'"
  :aria-live="toastSeverity === 'error' ? 'assertive' : 'polite'"
>
  <span
    class="shrink-0 w-2 h-2 rounded-full"
    :class="toastSeverity === 'error' ? 'bg-rose-500' : toastSeverity === 'warning' ? 'bg-amber-500' : toastSeverity === 'success' ? 'bg-[var(--accent)]' : 'bg-blue-500'"
  ></span>
  <span x-text="toastMsg"></span>
</div>
