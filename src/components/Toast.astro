<!-- Toast — OpenRouter subtle -->
<div x-show="toastMsg" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-1" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
  class="fixed bottom-16 sm:bottom-6 left-1/2 -translate-x-1/2 z-[60] flex items-center gap-2.5 rounded-full px-4 py-2 bg-[var(--strong)] text-white dark:bg-white dark:text-black shadow-xl text-xs font-medium mb-[env(safe-area-inset-bottom)]"
  role="status" aria-live="polite">
  <span class="shrink-0 w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
  <span x-text="toastMsg"></span>
</div>
